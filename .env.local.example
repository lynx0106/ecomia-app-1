# =============================================================================
# ECOMIA - ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Copia este archivo a .env.local y completa con tus valores reales
# Comando: cp .env.local.example .env.local
# 
# ⚠️ IMPORTANTE: Nunca subas .env.local a Git (ya está en .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE - Database & Authentication
# -----------------------------------------------------------------------------
# URL del proyecto de Supabase
# Dónde obtenerlo: https://app.supabase.com → Tu proyecto → Settings → API
# Formato: https://[tu-proyecto].supabase.co
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Clave pública (anon key) de Supabase
# Dónde obtenerlo: https://app.supabase.com → Tu proyecto → Settings → API → anon/public
# Nota: Esta clave es segura para exponerse en el frontend
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# -----------------------------------------------------------------------------
# GROQ - Large Language Model API
# -----------------------------------------------------------------------------
# API Key de Groq para el modelo de IA (LLaMA)
# Dónde obtenerlo: https://console.groq.com/keys
# Registro gratuito disponible con rate limits generosos
GROQ_API_KEY=your_groq_api_key

# -----------------------------------------------------------------------------
# TAVILY - Market Research & Web Search API
# -----------------------------------------------------------------------------
# API Key de Tavily para búsquedas de mercado en tiempo real
# Dónde obtenerlo: https://app.tavily.com/home → API Keys
# Plan gratuito: 1000 requests/mes
TAVILY_API_KEY=your_tavily_api_key

# =============================================================================
# NOTAS ADICIONALES
# =============================================================================
# 
# 1. DESARROLLO LOCAL:
#    - Puedes usar 'node generate-env.js' para generar automáticamente
#      (solo en desarrollo, incluye claves de prueba)
#
# 2. PRODUCCIÓN (Vercel, Railway, etc.):
#    - Configura estas variables en tu plataforma de deployment
#    - NO uses generate-env.js en producción
#    - Usa variables de entorno reales de tu panel de Supabase
#
# 3. SEGURIDAD:
#    - Las variables NEXT_PUBLIC_* son visibles en el cliente
#    - Las demás variables (GROQ_API_KEY, TAVILY_API_KEY) solo 
#      están disponibles en el servidor (API routes)
#
# 4. TESTING:
#    - Los tests pueden funcionar sin estas variables (mock mode)
#    - Para tests de integración, usa claves de desarrollo dedicadas
#
# =============================================================================
